<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Do NOT rewrite static assets or Next.js internal chunks
  RewriteRule ^_next/ - [L]
  RewriteRule \.(css|js|png|jpg|jpeg|gif|ico|svg|json|txt|woff|woff2)$ - [L]

  # Serve existing file or directory directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Check if clean URL has corresponding .html file (e.g. /intake -> /intake.html)
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # Fallback for client-side routing
  RewriteRule ^ index.html [L]
</IfModule>
